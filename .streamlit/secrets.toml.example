# ============================================================
# Curer Pre-Consultation AI Intake Bot — Secrets Configuration
# ============================================================
# Copy this file to: .streamlit/secrets.toml
# Fill in your actual credentials below.
# NEVER commit secrets.toml to version control.
# ============================================================

# --- Groq API Key ---
# Get yours at: https://console.groq.com
GROQ_API_KEY = "gsk_your_groq_api_key_here"

# --- Gmail SMTP Credentials ---
# Used to auto-send the briefing card to the doctor.
# Setup steps:
#   1. Create a Gmail account (or use a throwaway one)
#   2. Enable 2-Factor Authentication on the account
#   3. Go to: Google Account > Security > App Passwords
#   4. Generate a new app password for "Mail"
#   5. Copy the 16-character password below (spaces included)
GMAIL_ADDRESS = "your.curer.bot@gmail.com"
GMAIL_APP_PASSWORD = "xxxx xxxx xxxx xxxx"

# --- Doctor's Email ---
# The briefing card is automatically sent to this address
# after the patient completes the intake conversation.
DOCTOR_EMAIL = "doctor@example.com"
